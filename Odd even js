<!DOCTYPE html>
<html>
<head>
    <title>Odd or Even using GET Method</title>
</head>
<body>

    <h2>Check Odd or Even Number</h2>

    <!-- HTML Form using GET method -->
    <form method="GET" action="">
        Enter a Number: 
        <input type="number" name="num" required>
        <input type="submit" name="submit" value="Check">
    </form>

    <br>

    <?php
    // Check if the form is submitted and 'num' exists in the URL
    if (isset($_GET['submit'])) {
        
        // Retrieve the number from the textbox using $_GET
        $number = $_GET['num'];

        // Check if the number is divisible by 2
        if ($number % 2 == 0) {
            echo "<h3>$number is an Even number.</h3>";
        } else {
            echo "<h3>$number is an Odd number.</h3>";
        }
    }
    ?>

</body>
</html>
